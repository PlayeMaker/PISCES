                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/EAS/CanSM/CanSMGeneral/CanSMTxOfflineActiveSupport</DEFINITION-REF>
