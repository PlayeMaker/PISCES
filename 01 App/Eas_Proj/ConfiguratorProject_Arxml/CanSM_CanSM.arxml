                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/EAS/CanSM/CanSMGeneral/CanSMMainFunctionTimePeriod</DEFINITION-REF>
                  <VALUE>5</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/EAS/CanSM/CanSMGeneral/CanSMVersionInfoApi</DEFINITION-REF>
