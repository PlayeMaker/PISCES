          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="979dd7b3-3c55-404f-b75e-1f69c49b63af">
              <SHORT-NAME>EcuM_BootTarget</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <SERVICE-KIND>ECU-MANAGER</SERVICE-KIND>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION UUID="b8a67453-e8e3-47ed-8896-b83d1b55836d">
                  <SHORT-NAME>GetBootTarget</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE UUID="d11e7fc7-8b25-417e-b9de-7c5c059251d0">
                      <SHORT-NAME>target</SHORT-NAME>
