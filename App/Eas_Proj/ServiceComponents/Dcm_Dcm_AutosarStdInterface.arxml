          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="150cfd6c-858c-4e73-92ee-3e95504ef2ba">
              <SHORT-NAME>CallbackDCMRequestServices</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <SERVICE-KIND>DIAGNOSTIC-COMMUNICATION-MANAGER</SERVICE-KIND>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION UUID="578e6efa-6ea5-4d15-8679-7dc0387f1612">
                  <SHORT-NAME>StartProtocol</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE UUID="121038a1-ddef-4c35-80ac-5a8278f2d9cd">
                      <SHORT-NAME>ProtocolType</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/BSW/ImplementationDataTypes/Dcm_ProtocolType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
