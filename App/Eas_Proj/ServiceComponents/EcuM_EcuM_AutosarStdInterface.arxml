          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="0353ec57-0c29-4540-a566-96d7bd36ea79">
              <SHORT-NAME>EcuM_BootTarget</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <SERVICE-KIND>ECU-MANAGER</SERVICE-KIND>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION UUID="41c93c65-2195-480a-96bf-9aa66c0154fe">
                  <SHORT-NAME>GetBootTarget</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE UUID="62106192-57d0-408a-abcd-a8b3e666b238">
