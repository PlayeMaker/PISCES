          <SHORT-NAME>PortInterfaces</SHORT-NAME>
          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="be15a1a6-8dc2-4af3-8649-958337d130cf">
              <SHORT-NAME>EcuM_BootTarget</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <SERVICE-KIND>ECU-MANAGER</SERVICE-KIND>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION UUID="0ac6aea0-0bb5-43c9-b016-235881dfe179">
                  <SHORT-NAME>GetBootTarget</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE UUID="c0f71451-95f5-4d45-80d4-bdef0e8ce0c9">
                      <SHORT-NAME>target</SHORT-NAME>
