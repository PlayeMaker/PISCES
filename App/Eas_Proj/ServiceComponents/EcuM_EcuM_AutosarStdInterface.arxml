          <SHORT-NAME>PortInterfaces</SHORT-NAME>
          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="6081e44f-d137-4365-8425-f3b0bd35e3e6">
              <SHORT-NAME>EcuM_BootTarget</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <SERVICE-KIND>ECU-MANAGER</SERVICE-KIND>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION UUID="5d14e5b5-f233-4f41-99a0-c8034e3d1f06">
                  <SHORT-NAME>GetBootTarget</SHORT-NAME>
