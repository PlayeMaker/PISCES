          <SHORT-NAME>PortInterfaces</SHORT-NAME>
          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="a91d8350-41e7-4fd8-b26e-0e2479cb72ff">
              <SHORT-NAME>EcuM_BootTarget</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <SERVICE-KIND>ECU-MANAGER</SERVICE-KIND>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION UUID="bd18322b-54e8-466e-81dd-c3aa9a5230d7">
                  <SHORT-NAME>GetBootTarget</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE UUID="aeb6c0ae-bd3d-47c4-8bd5-11f94996751d">
                      <SHORT-NAME>target</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/BSW/ImplementationDataTypes/EcuM_BootTargetType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-ERROR-REFS>
                    <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/BSW/PortInterfaces/EcuM_BootTarget/E_OK</POSSIBLE-ERROR-REF>
