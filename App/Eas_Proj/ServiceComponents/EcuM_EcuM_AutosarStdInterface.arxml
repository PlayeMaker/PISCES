          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="da4e3e19-feba-40a9-9f54-3359df54aaac">
              <SHORT-NAME>EcuM_BootTarget</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <SERVICE-KIND>ECU-MANAGER</SERVICE-KIND>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION UUID="43a33bf0-a5db-40f0-8463-60e5adadbe74">
                  <SHORT-NAME>GetBootTarget</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE UUID="4269c25b-01d3-4342-bc29-88047ebbd828">
