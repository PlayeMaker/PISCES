          <ELEMENTS>
            <CLIENT-SERVER-INTERFACE UUID="5c4bf668-5ce1-43d0-9680-7952e2934e63">
              <SHORT-NAME>EcuM_BootTarget</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="BSW">
                    <SD GID="isBSW">True</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
