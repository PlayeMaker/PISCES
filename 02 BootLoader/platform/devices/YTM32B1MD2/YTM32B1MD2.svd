    <peripheral>
      <name>CRC0</name>
      <description>Cyclic Redundancy Check</description>
      <groupName>CRC</groupName>
      <prependToName>CRC0_</prependToName>
      <baseAddress>0x40065000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>16</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CTRL</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>INV_OUT</name>
              <description>Bit-inversion for all CRC output bits.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable the bit-inversion</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable the bit-inversion</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWAP_OUT</name>
              <description>Swap all the valid bits (16/32-bit) for CRC output data.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable the output bit-swap</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable the output bit-swap</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWAP_IN</name>
              <description>Enable bit-swap in each byte for CRC input data.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable the input bit-swap</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable the input bit-swap</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODE</name>
              <description>Select CRC calculation mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Select CRC-4 mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Select CRC-16 mode</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Select CRC-32 mode</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Select CRC-8 mode</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>INIT</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SEED</name>
              <description>This register contains the CRC initial seed value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>IN32</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATA</name>
              <description>CRC data input in 32 bits</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>RESULT</name>
          <description></description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>RESULT</name>
              <description>This register contains the result of CRC calculation. In CRC-16 mode, only the low 16 bits are valid. In CRC-4 mode, only the low 4 bits are valid.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


      </registers>
    </peripheral>

    <peripheral>
      <name>TRNG0</name>
      <description>True Random Number Generator</description>
      <groupName>TRNG</groupName>
      <prependToName>TRNG0_</prependToName>
      <baseAddress>0x40066000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>80</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CTRL</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x01220020</resetValue>
           <fields>
            <field>
              <name>RTY_CT</name>
              <description>It indicates the number of times a retry should occur before generating an error. Retry occurs when the statistical check fails during the TRNG entropy generation. This bit is writable only if UNLOCK bit is 1, or the UNLOCK bit is being written to 1 simultaneously.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LRUN_MAX</name>
              <description>It is the largest allowable number of consecutive samples of all 1 or all 0 during the entropy generation. This bit is writable only if UNLOCK bit is 1, or the UNLOCK bit is being written to 1 simultaneously.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FRQ_CT_IE</name>
              <description></description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disable.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enable.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENT_VAL_IE</name>
              <description></description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disable.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enable.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HW_ERR_IE</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Interrupt disable.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Interrupt enable.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FOR_SCLK</name>
              <description>If the bit is set, the system clock is used to operate the TRNG instead of the ring OSC. This bit is writable only if UNLOCK bit is 1, or the UNLOCK bit is being written to 1 simultaneously.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No effect.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Force the system clock to operate the TRNG instead of the ring OSC.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNLOCK</name>
              <description>This bit can prevent the value of various control bits from changing due to unexpected operation.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Lock. Write to the control bits has no effect. Write 0 to start entropy generation.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Unlock. The control bits are able to be modified. Write 1 to stop entropy generation.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLK_OUT</name>
              <description>After divided by 10, trng_osc_clk is output for test.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No effect.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>trng_osc_clk is output for test.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSC_DIV</name>
              <description>This field is writable only if UNLOCK bit is 1, or the UNLOCK bit is being written to 1 simultaneously.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No devider.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Ring OSC divided by 2.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Ring OSC divided by 4.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Ring OSC divided by 8.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TRNG_EN</name>
              <description>Enable the TRNG to generate and entropy value that can be read via ENT registers.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>TRNG disable.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>TRNG enable.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWR</name>
              <description>Writing 1 to this bit clears various TRNG registers(RTY_CT, LRUN_MAX, FOR_SCLK, CLK_OUT, OSC_DIV, SAMP_SIZE and SCML) to their default state. This bit is writable only if UNLOCK bit is 1, or the UNLOCK bit is being written to 1 simultaneously.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No effect.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Software reset.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>STAT</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>FRQ_CT_IF</name>
              <description>It indicate the frequency counter has detected a failure. The FRQMAX and FRQMIN registers has effect on it.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Frequency count success.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Frequency count fail.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENT_VAL_IF</name>
              <description>When entropy generation succeed, the TRNG will generate an entropy value that can be read via ENT registers and assert this bit.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No valid entropy value</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Valid entropy value can be read.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HW_ERR_IF</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No hardware error.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Hardware error happens.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IDLE</name>
              <description>The status of the entropy generation FSM.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>State idle.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>State busy.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FCT_VAL</name>
              <description>The frequency count for trng_osc_clk is valid to read.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>The frequency count for trng_osc_clk is not ready for read.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The frequency count for trng_osc_clk is ready to read.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>SDCTL</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0c8009c4</resetValue>
           <fields>
            <field>
              <name>ENT_DLY</name>
              <description>Defines the length of each entropy sample taken. This bit is writable only if UNLOCK bit is 1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SAMP_SIZE</name>
              <description>Defines the total number of entropy samples taken during entropy generation. This bit is writable only if UNLOCK bit is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FRQMIN</name>
          <description></description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000640</resetValue>
           <fields>
            <field>
              <name>FRQ_MIN</name>
              <description>Define the minimum allowable count taken during each entropy sample. This bit is writable only if UNLOCK bit is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FRQMAX</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00006400</resetValue>
           <fields>
            <field>
              <name>FRQ_MAX</name>
              <description>Define the maximum allowable count taken during each entropy sample. This bit is writable only if UNLOCK bit is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FRQCNT</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>FRQ_CT</name>
              <description>When STAT[ENT_VAL_IF]=1, reads a sample frequency count takes during entropy generation.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>SCML</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x010c0568</resetValue>
           <fields>
            <field>
              <name>MONO_RNG</name>
              <description>The number of ones detected during entropy generation must be greater than MONO_MAX - MONO_RNG, otherwise a retry or error will occur. This field is writable only if UNLOCK bit is 1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>MONO_MAX</name>
              <description>The number of ones detected during entropy generation must be less than MONO_MAX, otherwise a retry or error will occur. This field is writable only if UNLOCK bit is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>SCMC</name>
          <description></description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>MONO_CT</name>
              <description>Reads the final monobit count after entropy generation. Start from SCML[MONO_MAX], and is decremented each time a "1" is sampled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ENT0</name>
          <description></description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ENT</name>
              <description>The entropy value will be valid when STAT[ENT_VAL_IF] = 1. Reading the highest offset entropy will clear the entire entropy value and valid flag, and a new entropy generation will start.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ENT1</name>
          <description></description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ENT</name>
              <description>The entropy value will be valid when STAT[ENT_VAL_IF] = 1. Reading the highest offset entropy will clear the entire entropy value and valid flag, and a new entropy generation will start.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ENT2</name>
          <description></description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ENT</name>
              <description>The entropy value will be valid when STAT[ENT_VAL_IF] = 1. Reading the highest offset entropy will clear the entire entropy value and valid flag, and a new entropy generation will start.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ENT3</name>
          <description></description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ENT</name>
              <description>The entropy value will be valid when STAT[ENT_VAL_IF] = 1. Reading the highest offset entropy will clear the entire entropy value and valid flag, and a new entropy generation will start.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>


      </registers>
    </peripheral>

    <peripheral>
      <name>EMU0</name>
      <description>ECC Management Unit</description>
      <groupName>EMU</groupName>
      <prependToName>EMU0_</prependToName>
      <baseAddress>0x40072000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>364</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>EIGCR</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>GEN</name>
              <description>This bit will enable or disable all channels' error injection functions.
Write 0x89abcdef will enable this function.
Read 0 means, global error injection is disabled
Read 1 means, global error injection is enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHCR</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHEN</name>
              <description>This field enable or disable channel n error injection function. 
Enable channel n error injection function should enable this field and EIGCR[GEN]. 
Any write to EICHDn_ADDR, EICHDn_CHKBIT, EICHDn_DATA register will clear this field.
  0b - Channel n error injection is disabled
  1b - Channel n error injection is enabled when global error injection is enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

                                <register>
        <name>EICHD0_ADDR</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field defines which memory address will be injected error when read access. when the ADDR is not 0, error will be injected according to this field's value. If ADDR is 0xFFFFFFFF, error will be injected at all read access operation.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD0_CHKBIT</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHKBIT</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the checkbit bus from the target on-chip memory should be inverted or remain unmodified.\newline 0b - The corresponding bit of the checkbit bus remains unmodified.\newline 1b - The corresponding bit of the checkbit bus is inverted.\newline The checkbit can only support injecting error in fixed positions, the mask data is 4.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD0_DATA</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATA</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the read data bus from the target on-chip memory should be inverted or remain unmodified. \newline 0b - The corresponding bit of the databit bus remains unmodified. \newline 1b - The corresponding bit of the databit bus is inverted.\newline The databit can only support injecting error in fixed positions, the mask data is 2.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


        <register>
        <name>ERIE</name>
          <description></description>
          <addressOffset>0x110</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>NCIE</name>
              <description>Non-Correctable error interrupt enable.
  0b - Channel n Non-Correctable Error interrupt is disabled
  1b - Channel n Non-Correctable Error interrupt is enabled</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCIE</name>
              <description>Single correctable error interrupt enable
  0b - Channel n Single Correctable Error interrupt is disabled
  1b - Channel n Single Correctable Error interrupt is enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERIF</name>
          <description>This register is reset by Power-on Reset.</description>
          <addressOffset>0x114</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>NCIF</name>
              <description>Non-Correctable error interrupt flag. NCIF flag is kept when software reset but cleared when POR.
  0b - Channel n Non-Correctable Error interrupt not detected
  1b - Channel n Non-Correctable Error interrupt detected</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCIF</name>
              <description>Single Correctable error interrupt flag. SCIF flag is kept when software reset but cleared when POR.
  0b - Channel n Single Correctable Error interrupt not detected
  1b - Channel n Single Correctable Error interrupt detected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

                                <register>
        <name>ERINFO0_ADDR</name>
          <description>This register is reset by Power-on Reset.</description>
          <addressOffset>0x118</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field contains the faulting system address of the last recorded ECC event on on-chip memories.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO0_SYND</name>
          <description>This register is reset by Power-on Reset.</description>
          <addressOffset>0x11c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SYNDROME</name>
              <description>This field contains the syndrome of the last recorded ECC event on on-chip memories.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO0_CNT</name>
          <description>This register is reset by Power-on Reset.</description>
          <addressOffset>0x120</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>For each correctable error event, the EMU increments this field's error count value until the counter reaches its maximum value 0xFF. CNT will not change once it reaches 0xFF and will not wrap even if error occurs.
Read this field to determine the correctable error count value so far.
Write zero to this field to reset the counter. Writing non-zero (or partial zero) values has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>



      </registers>
    </peripheral>

    <peripheral>
      <name>CMU0</name>
      <description>Clock monitor unit</description>
      <groupName>CMU</groupName>
      <prependToName>CMU0_</prependToName>
      <baseAddress>0x40076000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>72</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CTRL</name>
          <description>System Clock Unit Clock Monitor Unit control register. 


Refer to Chip-specific chapter for Channels Information.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>REFS</name>
              <description>The reference clock of each CMU channel can be configured independently. 
 For CMU channel which monitor FXOSC clock, only SIRC clock can be used as reference clock. 
 For other channels, reference clock can select between SIRC clock and FXOSC clock. 

For each bit of CMU_REFS  :
 0b - The indexed channel select SIRC clock as reference clock; 
 1b - The indexed channel select FXOSC clock as reference clock.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RE</name>
              <description>The reset of each CMU channel can be configured independently.
 For each bit of CMU_RE:
 0b - Interrupt is generated when the indexed channel monitored clock is out of range; 
 1b - Reset is generated when the indexed channel monitored clock is out of range.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EN</name>
              <description>CMU has up to 8 channels to monitor internal clocks. 
 Software can configure a CMU channel only when that channel is disabled. For CMU channel n, please configure CTRL.REFS[n], CTRL.RE[n], CMPn, REFCNTTGTn before set CTRL.EN[n] high.
 
 Each CMU channel can be enable or disabled independently. For each bit of CMU_EN:
 0b - The indexed channel is disabled; 
 1b - The indexed channel is enabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>STS</name>
          <description>System Clock Unit Clock Monitor Unit status register. This register is reset by Power-on Reset.</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>LOSV</name>
              <description>CMU_LOSV[n]=1 (n=0~7) means channel n loss of monitored clock valid in CLKVLDDLY selected time slice .
 This register is reset by Power-on Reset.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LOSC</name>
              <description>CMU_LOSC[n]=1 (n=0~7) means channel n loss of monitored clock.
 This register is reset by Power-on Reset.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LOSR</name>
              <description>CMU_LOSR[n]=1 (n=0~7) means channel n loss of reference clock.
 This register is reset by Power-on Reset.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUTRNG</name>
              <description>CMU_OUTRNG[n]=1 (n=0~7) means channel n monitored clock out of range.
 This register is reset by Power-on Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

                                <register>
        <name>CMP0_HIGH</name>
          <description>Clock Monitor High Comparison Value Register.</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000ffff</resetValue>
           <fields>
            <field>
              <name>VAL</name>
              <description>Monitored clock counter will compare with this register when reference clock counter equals REFCNTTGT. If monitored clock counter larger than this register, CMU initiate an out-of-range event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CMP0_LOW</name>
          <description>Clock Monitor Low Comparison Value Register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>VAL</name>
              <description>Monitored clock counter will compare with this register when reference clock counter equals REFCNTTGT. If monitored clock counter less than this register, CMU initiate an out-of-range event.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


                                <register>
        <name>CMP1_HIGH</name>
          <description>Clock Monitor High Comparison Value Register.</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000ffff</resetValue>
           <fields>
            <field>
              <name>VAL</name>
