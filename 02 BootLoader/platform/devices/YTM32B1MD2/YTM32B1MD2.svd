              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH1011COMBSRC</name>
              <description>When CH1011COMBSRC=0, select channel 10 as combination capture input source. When CH1011COMBSRC=1, select channel 11 as combination capture input source.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH89COMBSRC</name>
              <description>When CH89COMBSRC=0, select channel 8 as combination capture input source. When CH89COMBSRC=1, select channel 9 as combination capture input source.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH67COMBSRC</name>
              <description>When CH67COMBSRC=0, select channel 6 as combination capture input source. When CH67COMBSRC=1, select channel 7 as combination capture input source.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH45COMBSRC</name>
              <description>When CH45COMBSRC=0, select channel 4 as combination capture input source. When CH45COMBSRC=1, select channel 5 as combination capture input source.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH23COMBSRC</name>
              <description>When CH23COMBSRC=0, select channel 2 as combination capture input source. When CH23COMBSRC=1, select channel 3 as combination capture input source.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH01COMBSRC</name>
              <description>When CH01COMBSRC=0, select channel 0 as combination capture input source. When CH01COMBSRC=1, select channel 1 as combination capture input source.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH1415COMBEN</name>
              <description>When CH1415COMBEN=1, pulse capture is realized by channel 14 and channel 15 combination. Channel 14 and channel 15 need to be configured separately.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH1213COMBEN</name>
              <description>When CH1213COMBEN=1, pulse capture is realized by channel 12 and channel 13 combination. Channel 12 and channel 13 need to be configured separately.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH1011COMBEN</name>
              <description>When CH1011COMBEN=1, pulse capture is realized by channel 10 and channel 11 combination. Channel 10 and channel 11 need to be configured separately.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH89COMBEN</name>
              <description>When CH89COMBEN=1, pulse capture is realized by channel 8 and channel 9 combination. Channel 8 and channel 9 need to be configured separately.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH67COMBEN</name>
