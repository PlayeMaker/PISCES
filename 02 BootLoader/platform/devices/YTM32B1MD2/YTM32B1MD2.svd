          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PSO</name>
              <description>Writing to this register will update the contents of the corresponding bit in PDOR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0b</name>
                  <description>No change.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1b</name>
                  <description>Corresponding bit in PDOR is set to logic 1.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>PCOR</name>
