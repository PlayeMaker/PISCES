                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Reserved</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Reserved</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Over sample value is 4, need to set BOTHEDGE bit</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>Over sample value is 5, need to set BOTHEDGE bit</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>Over sample value is 6, need to set BOTHEDGE bit</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>Over sample value is 7, need to set BOTHEDGE bit</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>Over sample value is 8.</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>Over sample value is 9.</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9</name>
                  <description>Over sample value is 10.</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>Over sample value is 11.</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11</name>
                  <description>Over sample value is 12.</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>Over sample value is 13.</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>13</name>
                  <description>Over sample value is 14.</description>
                  <value>13</value>
                </enumeratedValue>
