          <access>read-write</access>
          <resetValue>0x000f0004</resetValue>
           <fields>
            <field>
              <name>OSRVAL</name>
              <description>Over sample config, only support update when module disabled</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
