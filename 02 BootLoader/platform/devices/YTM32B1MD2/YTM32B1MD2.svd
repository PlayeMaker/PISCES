                <enumeratedValue>
                  <name>6</name>
                  <description>Select channel 6 PWM as the pulse-out signal.</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>select channel 7 PWM as the pulse-out signal.</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSRC</name>
              <description>Trigger output source: matching event occurs or PWM output.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
