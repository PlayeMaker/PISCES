                  <description>Readback compare failure event occurs detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RFEIF</name>
              <description>RX FIFO underflow happened, read RX FIFO when RX FIFO empty will set this bit</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
