                <enumeratedValue>
                  <name>1</name>
                  <description>RX FIFO underflow detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TFEIF</name>
              <description>TX FIFO overflow happened, write TX FIFO when RX FIFO full will set this bit</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
