        <register>
        <name>COMBCMP</name>
          <description></description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CH1415COMBSRC</name>
              <description>When CH1415COMBSRC=0, select channel 14 as combination capture input source. When CH1415COMBSRC=1, select channel 15 as combination capture input source.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH1213COMBSRC</name>
