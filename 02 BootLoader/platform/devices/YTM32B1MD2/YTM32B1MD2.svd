              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH45COMBEN</name>
              <description>When CH45COMBEN=1, pulse capture is realized by channel 4 and channel 5 combination. Channel 4 and channel 5 need to be configured separately.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH23COMBEN</name>
              <description>When CH23COMBEN=1, pulse capture is realized by channel 2 and channel 3 combination. Channel 2 and channel 3 need to be configured separately.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH01COMBEN</name>
