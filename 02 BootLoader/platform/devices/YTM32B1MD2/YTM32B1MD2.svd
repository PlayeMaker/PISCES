    <peripheral>
      <name>MPWM0</name>
      <description>Multiple Pulse Width Modulation</description>
      <groupName>MPWM</groupName>
      <prependToName>MPWM0_</prependToName>
      <baseAddress>0x4004F000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>1024</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>IOSTS</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CH15IO</name>
              <description>Indicate channel 15 input/output status in pwm mode, compare mode and input capture mode. This bit is read only and the write operation is invalid.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Channel status is 0.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Channel status is 1.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CH14IO</name>
              <description>Indicate channel 14 input/output status in pwm mode, compare mode and input capture mode. This bit is read only and the write operation is invalid.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Channel status is 0.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Channel status is 1.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CH13IO</name>
              <description>Indicate channel 13 input/output status in pwm mode, compare mode and input capture mode. This bit is read only and the write operation is invalid.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
