<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd">
  <vendor>YTMicro</vendor>
  <vendorID>YTMicro</vendorID>
  <name>YTM32B1MD2</name>
  <series></series>
  <version>1.0</version>
  <description>YTM32B1MD2 YTMicro Microcontroller</description>
  <licenseText>YTMicro Microcontroller all rights reserved.</licenseText>
  <cpu>
    <name>CM33</name>
    <revision>r0p4</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>true</fpuPresent>
    <nvicPrioBits>2</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>EFM</name>
      <description>Embedded Flash Module</description>
      <groupName>EFM</groupName>
      <prependToName>EFM_</prependToName>
      <baseAddress>0x40010000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>780</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CTRL</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x800c0100</resetValue>
           <fields>
            <field>
              <name>LPEN</name>
              <description>This LPEN bit determines whether the Flash array will enter low power mode when the MCU send a low power request.\newline This field is reset by System Reset.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash will keep active when the MCU send a low power request</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash will enter low power mode when the MCU send a low power request.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FWUP_EN</name>
              <description>This FWUP_EN bit determines whether enables fast wake-up of the Flash array. Power consumption of fast wake-up is bigger than normal wake-up.\newline This field is reset by System Reset.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash wake-up time from Deep Standby mode is 20us.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash wake-up time from Deep Standby mode is 10us.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRESCALER</name>
              <description>These PRESCALER bits are used for EFM operation time control. \newline Please use the following equation to calculate the PRESCALER value:\newline PRESCALER = Slow Bus Clock frequency / 2 \newline Round up if not divisible. \newline The unit of Slow Bus Clock frequency is Mhz.\newline For example, if Slow Bus Clock frequency is 40Mhz, PRESCALER value should be 20.\newline If Slow Bus Clock frequency is 23Mhz, PRESCALER value should be 12.\newline Please re-configure PRESCALER once the frequency is changed.\newline This field is reset by System Reset.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WE</name>
              <description>This WE bit determines whether Flash is writable. Write Flash when WE is low causes bus error and STS[CI_WEERR] flag is set at the same time .\newline In the command operation flow, please set WE before AHB write and clear WE after AHB write .\newline This field is reset by System Reset.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable Flash write.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable Flash write.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RWS</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Valid value for core clk &lt;= 40Mhz. in Normal Read mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Valid value for core clk &lt;= 80Mhz. in Normal Read mode</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Valid value for core clk &lt;= 100Mhz in Normal Read mode</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Valid value for core clk &lt;= 100Mhz. in Normal Read mode</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CMD_VERIFY_EN</name>
              <description>This CMD_VERIFY_EN bit determines whether to do verify read after erase or program operation during executing a command. \newline - After each program cycle, if CMD_VERIFY_EN=1, EFM read the programmed address and compare the read data to program data. If not equal, set STS[CMD_FAIL] flag high \newline - After each erase cycle, if CMD_VERIFY_EN=1, EFM read the erased addresses and compare read data with FF. If read data are not all FF, set STS[CMD_FAIL] flag high.\newline This field is reset by System Reset.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable verify read after erase or program cycle.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable verify read after erase or program cycle</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACCERRIE</name>
              <description>This ACCERRIE bit determines whether the interrupt will be generated when STS[ACCERR] flag is asserted.\newline This field is reset by System Reset.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Don't generate interrupt when STS[ACCERR] flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Generate interrupt when STS[ACCERR] flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNRECOVERRIE</name>
              <description>This UNRECOVERRIE bit determines whether the interrupt will be generated when STS[UNRECOVERR] flag is asserted.\newline This field is reset by System Reset.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Don't generate interrupt when STS[UNRECOVERR] flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Generate interrupt when STS[UNRECOVERR] flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RECOVERRIE</name>
              <description>This RECOVERRIE bit determines whether the interrupt will be generated when STS[RECOVERR] flag is asserted.\newline This field is reset by System Reset.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Don't generate interrupt when STS[RECOVER] flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Generate interrupt when STS[RECOVERR] flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DONEIE</name>
              <description>This DONEIE bit determines whether the interrupt will be generated when DONE flag is asserted.\newline This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Don't generate interrupt when STS[DONE] flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Generate interrupt when STS[DONE] flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>STS</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000080</resetValue>
           <fields>
            <field>
              <name>CI_RDVIOLERR</name>
              <description>This CI_RDVIOLERR bit indicates whether a read violation error is detected. Please check this bit after bus error.  \newline
Read violation error includes below scenarios: \newline - Read CUS_NVR sector when CUS_KEY is not set.\newline - Read HCU_NVR sector.\newline - Read BOOT_NVR sector. \newline This field is reset by System Reset.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CI_WEERR</name>
              <description>Try to write Flash array when CTRL[WE] is disabled will cause bus error and set CI_WEERR flag.\newline This field is reset by System Reset.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CI_BUSYERR</name>
              <description>Try to access Flash array when CTRL[IDLE] is 0 will cause bus error and set CI_BUSYERR flag.\newline This field is reset by System Reset.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BOOT_INFO</name>
              <description>This BOOT_INFO bit indicates whether PFlash SoC address remap is enabled.\newline This field is reset by System Reset.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>PFlash SoC address remap is disabled, SoC boots code from A side.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>PFlash SoC address remap is enabled, SoC boots code from B side. Refer to \hyperref[boot-swap-operation]{Boot-Swap Operation} for more details.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IDLE</name>
              <description>This IDLE bit indicates whether EFM is busy executing a command or initializing or in low power mode.\newline IDLE bit may not be low immediately after writing a command because EFM needs to wait for core interface free before starting execute the command. This field is reset by System Reset.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>EFM is executing a command or initializing or in low power mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>EFM is idle.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ARRAY_SELECTED</name>
              <description>Software should write target array address before launching a command. The write operation will set ARRAY_SELECTED flag after several cycles. \newline This field is reset by System Reset.\newline \note{Launching command when ARRAY_SELECTED=1 avoid access error caused by non-sequential scheduling of instructions.}</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>The target Flash array is not selected. EFM is not ready to launch a command.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The target Flash array is selected. EFM is ready to launch a command.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CMD_FAIL</name>
              <description>This CMD_FAIL bit indicates whether the current command is failed. \newline \newline Command failure includes below scenarios: \newline - Read check before a program cycle failed if Flash line bits are not all FF. \newline - Verify check after an erase cycle failed if Flash line bits are not cleared to all FF.\newline - Verify check after a program cycle failed if program data not equal to read data.
\newline \newline This field is reset by System Reset.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACCERR</name>
              <description>This ACCERR bit indicates whether an access error is detected. \newline This flag is set if detecting an error when write CMD register. \newline If an access error occurred, the command is not launched. \newline Access error scenarios refer to \hyperref[flash-abnormal-operation]{Flash Abnormal Operation}.\newline This field is reset by System Reset.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Access error is not detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Access error is detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNRECOVERR</name>
              <description>This UNRECOVERR bit indicates whether a 2-bit ECC error is detected during Flash read. \newline This field is reset by Power-on Reset.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No un-recovery ECC error is detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>At least one un-recovery ECC error is detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RECOVERR</name>
              <description>This RECOVERR bit indicates whether a 1-bit ECC error is detected during Flash read.\newline This field is reset by Power-on Reset.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No recovery ECC error  is detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>At least one recovery error is detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DONE</name>
              <description>This DONE bit indicates whether the current command is completed.\newline This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Current command is in progress or no command is launched.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Current command is completed.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD</name>
              <description>These CMD bits determine which commands are available. Write valid command code to CMD to launch a command. \newline Refer to table \hyperref[efm-commands]{EFM commands} for command code.\newline This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD_PROT</name>
          <description></description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD_PROT</name>
              <description>These CMD_PROT is used to disable commands. \newline If any bit of CMD_PROT is set high, its corresponding command is disabled.\newline Refer to \hyperref[efm-commands]{EFM commands} table for the map between commands and CMD_PROT bits \newline This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>TIMING1</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
           <fields>
            <field>
              <name>TPROG_SEL</name>
              <description>These TPROG_SEL bits indicate the program pulse time. \newline The valid program pulse time is from 5us to 6.5us. Specific program time is decided by TPROG_SEL by fixed step. \newline For example, if TPROG_SEL is 01, the Flash array program pulse time is 5.5us.\newline This register bit is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash array program pulse time is 5us.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash array program pulse time is 5.5us.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Flash array program pulse time is 6us.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Flash array program pulse time is 6.5us.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>TIMING2</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010001</resetValue>
           <fields>
            <field>
              <name>TERASE_BLK_SEL</name>
              <description>These TERASE_BLK_SEL bits indicate the block erase pulse times. \newline The valid block erase pulse time is from 30ms to 40ms. Specific block erase time is decided by TERASE_BLK_SEL. \newline For example, if TERASE_BLK_SEL value is 01, the Flash array block erase pulse time is 34ms.\newline This register bit is reset by System Reset. \note{Please set TERASE_BLK_SEL register to valid value before send ERASE_BLOCK command.}</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash array block erase pulse time is 31ms.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash array block erase pulse time is 34ms.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Flash array block erase pulse time is 36ms.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Flash array block erase pulse time is 39ms.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TERASE_SEC_SEL</name>
              <description>These TERASE_SEC_SEL bits indicate the sector erase pulse times. \newline The valid block erase pulse time is from 2ms to 3ms. Specific block erase time is decided by TERASE_BLK_SEL. \newline For example, if TERASE_SEC_SEL value is 01, the Flash array sector erase pulse time is 2.4ms.\newline This register bit is reset by System Reset. \note{Please set TERASE_SEC_SEL register to valid value before send ERASE_SECTOR command.}</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash array sector erase pulse time is 2.1ms.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash array sector erase pulse time is 2.4ms.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Flash array sector erase pulse time is 2.6ms.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Flash array sector erase pulse time is 2.9ms.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>ERR_INJECT_CTRL</name>
          <description></description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ECCERR_INJ_EN</name>
              <description>Set this ECCERR_INJ_EN bits while cause 1-bit/ 2-bit ECC error for all Flash read out data. \newline Write ECCERR_INJ_EN will set ECCERR_INJ_ST high. And ECCERR_INJ_ST will auto clear when core interface is free.\newline Configuration to this field is valid only after ECCERR_INJ_ST goes from high to low.\newline This field is reset by System Reset.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>Disable ECC error inject .</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>Inject 1-bit ECC error for any address.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>Inject 1-bit ECC error for any address.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>Inject 2-bit ECC error for any address.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT0</name>
          <description></description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>ADDR_PROT</name>
              <description>Flash main array is divided into 32 partitions. Each partition is protected by one bit of ADDR_PROT. The size of each partition is 8KB. \newline
All bits of ADDR_PROT is 1. If any bit of ADDR_PROT is clear to 0, its corresponding partition is under protection (read only). Erase or program to this protected partition is invalid. \newline
EFM hardware initialization flow (STS[IDLE]=0) will load ADDR_PROT registers with initial values from CUS_NVR array if the CUS_NVR has programmed with initial ADDR_PROT values and Tag. \newline After EFM hardware initial done (STS[IDLE]=1), software can write 0 to any bit of ADDR_PROT, but can not write 1 to it.\newline
This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT1</name>
          <description></description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>ADDR_PROT</name>
              <description>Flash main array is divided into 32 partitions. Each partition is protected by one bit of ADDR_PROT. The size of each partition is 8KB. \newline
All bits of ADDR_PROT is 1. If any bit of ADDR_PROT is clear to 0, its corresponding partition is under protection (read only). Erase or program to this protected partition is invalid. \newline
EFM hardware initialization flow (STS[IDLE]=0) will load ADDR_PROT registers with initial values from CUS_NVR array if the CUS_NVR has programmed with initial ADDR_PROT values and Tag. \newline After EFM hardware initial done (STS[IDLE]=1), software can write 0 to any bit of ADDR_PROT, but can not write 1 to it.\newline
This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT2</name>
          <description></description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>ADDR_PROT</name>
              <description>Flash main array is divided into 32 partitions. Each partition is protected by one bit of ADDR_PROT. The size of each partition is 8KB. \newline
All bits of ADDR_PROT is 1. If any bit of ADDR_PROT is clear to 0, its corresponding partition is under protection (read only). Erase or program to this protected partition is invalid. \newline
EFM hardware initialization flow (STS[IDLE]=0) will load ADDR_PROT registers with initial values from CUS_NVR array if the CUS_NVR has programmed with initial ADDR_PROT values and Tag. \newline After EFM hardware initial done (STS[IDLE]=1), software can write 0 to any bit of ADDR_PROT, but can not write 1 to it.\newline
This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ECCERR_ADDR</name>
          <description></description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>ERR_FLASH_ADDR</name>
              <description>These bits records the first detected ECC error address. Followed ECC error addresses are not recorded.\newline When detecting an ECC error, hardware will set ECC error flag (RECOVERR or UNRECOVERR) and record information about this error when ECCERR_ADDR is empty. \newline
ECCERR_ADDR is cleared by writing 1 to the recorded RECOVERR or UNRECOVERR flag. For example, if ECCERR_ADDR records UNRECOVERR address information, only write 1 to UNRECOVERR can clear ECCERR_ADDR, writing 1 to RECOVERR can not clear ECCERR_ADDR.\newline
Read ECCERR_ADDR to get SOC address of the recorded ECC error.\newline ECCERR_ADDR is aligned to 4Byte (i.e. 0x0, 0x4, 0x8, 0xC, 0x10, ......) because a FLash read get a 32-bit page data. Bus read 8-/16-bit data in address range ECCERR_ADDR~(ECCERR_ADDR+0x3) get the same ECC result.\newline
This field is reset by Power-on Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ECCERR_CNT</name>
          <description></description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ECCERR_INJ_ST</name>
              <description>This bit shows whether configuration of ERR_INJECT_CTRL is valid.\newline This bit is set when software write ERR_INJECT_CTRL register and is cleared by hardware when configuration in ERR_INJECT_CTRL is valid.\newline Software need to wait ECCERR_INJ_ST negative-edge after configuring ERR_INJECT_CTRL register.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Hasn't configure ERR_INJECT_CTRL, or configuration in ERR_INJECT_CTRL is valid.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Configure ERR_INJECT_CTRL is on-going and configuration in ERR_INJECT_CTRL is invalid.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ECCERR_CNT</name>
              <description>These ECCERR_CNT bits record 1-bit ECC errors and 2-bit ECC errors .\newline This field is reset by Power-on Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>RSA_KEY_CFG</name>
          <description></description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000007f</resetValue>
           <fields>
            <field>
              <name>RSA_KEY_NUM</name>
              <description>These bits are used to set RSA_KEY number when executing command LOAD_RSA_KEY.\newline LOAD_RSA_KEY command will send ((RSA_KEY_NUM+1)*32) bit width RSA_KEY to HCU.\newline This field is reset by System Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD_UNLOCK</name>
          <description></description>
          <addressOffset>0x200</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD_UNLOCK_KEY</name>
              <description>Please write 0xfd9573f5 before launching a command.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CUS_KEY</name>
          <description></description>
          <addressOffset>0x204</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CUS_KEY_MATCH</name>
              <description>This CUS_KEY_MATCH bit indicates whether Customer Key is matched. \newline Write CUS_KEY with correct value when both CUS_KEY_MATCH and CUS_KEY_MISMATCH are low will set this flag high.\newline When CUS_KEY_MATCH is high, write error value to CUS_KEY will clear this flag. \newline When CUS_KEY_MISMATCH is high, this flag is low until a reset happened.\newline This field is reset by System Reset.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Customer Key is not matched</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Customer Key is matched</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CUS_KEY_MISMATCH</name>
              <description>This CUS_KEY_MISMATCH bit indicates whether Customer Key is mis-matched. \newline Write CUS_KEY with error value when both CUS_KEY_MATCH and CUS_KEY_MISMATCH are low will set this bit to high.\newline When CUS_KEY_MISMATCH is high, CUS_KEY configuration is blocked. \newline This field is reset by Power-on Reset.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Customer Key is matched</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Customer Key is not matched</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CUS_KEY</name>
              <description>Following are Customer Key protected operations, please write CUS_KEY with correct value before doing these operations: \newline - Read or erase or program CUS_NVR\newline - Erase HCU_NVR array if it is exist \newline
Default Customer Key value is 0x4DFF32 and the Customer Key value can be overridden by programming the first address of CUS_NVR and then reset EFM.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CTRL_OVRD</name>
          <description></description>
          <addressOffset>0x300</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DFLASH_PREREAD_DIS</name>
              <description>When executing a program command, EFM will read DFlash and check if the target address is erased empty before send a program pulse. If target address is not empty, no program pulse is send to DFlash. The program command failed.\newline A method to inject ECC error into Flash array, software can set PREREAD_DIS=1 and then program a Flash line twice with different data.\newline This field is reset by System Reset.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Pre-read function is enabled before send a program pulse.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Pre-read function is disabled before send a program pulse.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PFLASH_PREREAD_DIS</name>
              <description>When executing a program command, EFM will read Flash and check if the target address is erased empty before send a program pulse. If target address is not empty, no program pulse is send to PFlash. The program command failed.\newline To inject ECC error into Flash array, software can set PREREAD_DIS=1 and then program a Flash line twice with different data.\newline This field is reset by System Reset.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Pre-read function is enabled before send a program pulse.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Pre-read function is disabled before send a program pulse.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBG_DISABLE</name>
              <description>This bit determines whether the debugger is disabled.\newline This register bit is write protected by CUS_KEY.\newline This field is reset by System Reset.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Debugger is enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Debugger is disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PFLASH_ECC_DIS</name>
              <description>This bit determines whether PFlash ECC Decoder is disabled.\newline This field is reset by Power-on Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>


      </registers>
    </peripheral>

    <peripheral>
      <name>CACHE</name>
      <description>Cache Controller and Cache Array</description>
      <groupName>CACHE</groupName>
      <prependToName>CACHE_</prependToName>
      <baseAddress>0xE0080000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>100</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CACR</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMDREQ</name>
              <description>Initiate cache cperation command request. Setting this bit initiates the cache command indicated by bits 26,24. Reading this bit indicates if a command is active</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Write: no effect. Read: no cache command active.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Write: initiate command indicated by bits 26,24. Read: cache command active.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IW1</name>
              <description>Invalidate way 1 operation</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>When setting CMDREQ bit, invalidate all lines in way 1.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IW0</name>
              <description>Invalidate way 0 operation</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>When setting CMDREQ bit, invalidate all lines in way 0.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EN</name>
              <description>Enable Cache</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Cache is disable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Cache is enable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CALCR</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>LADDRS</name>
              <description>When using the cache address, the way must also be specified in CALCR[WS]. When using the physical address, both ways are searched and the command is performed only if a hit.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Cache address</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Physical address</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LCMD</name>
              <description>Line command</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Reserved</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Invalidate</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Reserved</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Reserved</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LCMDW</name>
              <description>Indicates the way used by the line command.Only applies if valid bit LCMDREQV = 1.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LCMDREQV</name>
              <description>If command used cache address and way, then this bit shows the initial state of the valid bit. If command used physical address and a hit, then this bit shows the initial state of the valid bit. If a miss, this bit reads zero.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WS</name>
              <description>Select the way for line commands</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Way 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Way 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CAADDR</name>
              <description>Cache address to access cache tag array.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LCMDREQ</name>
              <description>Initiate cache line command request. Setting this bit initiates the cache line command indicated by bits 26-24. Reading this bit indicates if a line command is active. This bit stays set until the command completes. Writing zero has no effect. This bit is shared with CASAR[LCMDREQ].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Write: no effect. Read: no line command active.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Write: initiate line command indicated by bits 26-24. Read: line command active.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CASAR</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PHYADDR</name>
              <description>PHYADDR represents bits [31:4] of the system address. CASAR[31:11] bits are used for tag compare. CASAR[10:4] bits are used to access the tag arrays.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LCMDREQ</name>
              <description>Initiate Cache Line Command. Setting this bit initiates the cache line command indicated by bits 26-24. Reading this bit indicates if a line command is active. This bit stays set until the command completes. Writing zero has no effect. This bit is shared with CALCR[LCMDREQ].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Write: no effect. Read: no line command active.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Write: initiate line command indicated by bits CALCR[26:24]. Read: line command active.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CAMR</name>
          <description></description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x88000000</resetValue>
           <fields>
            <field>
              <name>PFLASHCM</name>
              <description>Controls the cache mode of PFlash. It's default 1b after system reset. Once it's been cleared, it can't be set again until next reset.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Non-cacheable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Write-through</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OCRAMCM</name>
              <description>Controls the cache mode of OCRAM</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Write-through</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Non-cacheable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CAPCR</name>
          <description></description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CAPREN</name>
              <description>Enable Cache Parity Reporting</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable cache parity reporting</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable cache parity reporting</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CAPFEN</name>
              <description>Enable Cache Parity Fault</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable cache parity fault</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable cache parity fault</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CAPFBDIS</name>
              <description>Disable Cache Parity Fault Bus Error</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Enable cache parity fault bus error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Disable cache parity fault bus error</description>
                  <value>1</value>
                </enumeratedValue>
