    <peripheral>
      <name>UART1</name>
      <description>UART module with LIN mode support</description>
      <groupName>UART</groupName>
      <prependToName>UART1_</prependToName>
      <baseAddress>0x4001C000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>32</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>BAUD</name>
          <description></description>
