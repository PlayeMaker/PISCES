                <enumeratedValue>
                  <name>1</name>
                  <description>RESERVED</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>DMA engine wait 4 cycles after each R/W</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
